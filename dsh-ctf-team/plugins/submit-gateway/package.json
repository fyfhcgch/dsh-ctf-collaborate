{
  "name": "@dsh-external/dsh-submit-gateway",
  "description": "HTTP 提交网关：注册 POST /api/ctf/submit，接收 plan.submit 格式 JSON（planId/category/title/description/ciphertext/attachments...），内部调用 ctx.planner.start 发起计划，使外部 PowerShell/curl 可直接提交 CTF 题目进入多 Agent 工作流。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
